@model AnalyticsViewModel
@using System.Globalization
@{
    ViewData["Title"] = "HR Analytics";
    var inv = CultureInfo.InvariantCulture;

    double total = Math.Max(Model.Total, 1);
    double pDone = Model.Done / total * 100;
    double pPending = Model.Pending / total * 100;
    string donutBg = Model.Total == 0
        ? "#edf0f6"
        : $"conic-gradient(#16a34a 0 {pDone.ToString("0.##", inv)}%, #d97706 {pDone.ToString("0.##", inv)}% {(pDone + pPending).ToString("0.##", inv)}%, #dc2626 {(pDone + pPending).ToString("0.##", inv)}% 100%)";

    int maxSkill = Model.TopSkills.Count == 0 ? 1 : Model.TopSkills.Max(s => s.Count);
    int maxMissing = Model.TopMissing.Count == 0 ? 1 : Model.TopMissing.Max(s => s.Count);
}
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/analytics.css" asp-append-version="true" />

<div class="dash">
    <div class="dash-head">
        <div>
            <h1>HR Analytics</h1>
            <p class="muted">Статистика та результати AI-аналізу кандидатів</p>
        </div>
        <div class="head-actions">
            <a class="btn-ghost" asp-controller="Dashboard" asp-action="Index">HR Dashboard</a>
            <a class="btn-ghost" asp-controller="Home" asp-action="Menu">← Головне меню</a>
        </div>
    </div>

    @if (Model.Error != null)
    {
        <div class="alert-box">@Model.Error</div>
    }

    <div class="stats">
        <div class="stat"><span class="stat-num">@Model.Total</span><span class="stat-label">Усього кандидатів</span></div>
        <div class="stat"><span class="stat-num ok">@Model.Done</span><span class="stat-label">Проаналізовано</span></div>
        <div class="stat"><span class="stat-num wait">@Model.Pending</span><span class="stat-label">Очікує аналізу</span></div>
        <div class="stat"><span class="stat-num">@(Model.AvgMatch.HasValue ? Model.AvgMatch.Value.ToString("0") + "%" : "—")</span><span class="stat-label">Середня відповідність</span></div>
        <div class="stat"><span class="stat-num">@(Model.AvgExperience.HasValue ? Model.AvgExperience.Value.ToString("0.#") : "—")</span><span class="stat-label">Середній досвід, років</span></div>
        <div class="stat"><span class="stat-num ok">@Model.HighMatch</span><span class="stat-label">Відповідність ≥ 75%</span></div>
    </div>

    <div class="charts">
        <section class="panel chart">
            <h4>Кандидати за статусом</h4>
            <div class="donut-wrap">
                <div class="donut" style="background: @donutBg">
                    <div class="donut-hole"><b>@Model.Total</b><span>усього</span></div>
                </div>
                <ul class="legend">
                    <li><i class="dot" style="background:#16a34a"></i>Проаналізовано <b>@Model.Done</b></li>
                    <li><i class="dot" style="background:#d97706"></i>Очікує аналізу <b>@Model.Pending</b></li>
                    <li><i class="dot" style="background:#dc2626"></i>Помилка <b>@Model.Failed</b></li>
                </ul>
            </div>
        </section>

        <section class="panel chart wide">
            <h4>Відповідність вимогам вакансії</h4>
            @if (Model.ByMatch.Count == 0)
            {
                <p class="muted">Поки немає проаналізованих кандидатів.</p>
            }
            else
            {
                <div class="hbars">
                    @foreach (var c in Model.ByMatch)
                    {
                        double pct = Math.Clamp(c.MatchPercent ?? 0, 0, 100);
                        string level = pct >= 75 ? "high" : pct >= 50 ? "mid" : "low";
                        <div class="hbar-row">
                            <a class="hbar-label" asp-controller="Dashboard" asp-action="Details" asp-route-key="@c.Id" title="@c.Name">@c.Name</a>
                            <div class="bar"><div class="bar-fill @level" style="width:@(pct.ToString("0", inv))%"></div></div>
                            <b class="hbar-value">@pct.ToString("0")%</b>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="panel chart wide">
            <h4>Найчастіші знайдені навички</h4>
            @if (Model.TopSkills.Count == 0)
            {
                <p class="muted">Поки немає даних про навички.</p>
            }
            else
            {
                <div class="hbars">
                    @foreach (var s in Model.TopSkills)
                    {
                        double w = s.Count * 100.0 / maxSkill;
                        <div class="hbar-row">
                            <span class="hbar-label" title="@s.Name">@s.Name</span>
                            <div class="bar"><div class="bar-fill skill" style="width:@(w.ToString("0", inv))%"></div></div>
                            <b class="hbar-value">@s.Count</b>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="panel chart">
            <h4>Найчастіше не підтверджені вимоги</h4>
            @if (Model.TopMissing.Count == 0)
            {
                <p class="muted">Немає даних.</p>
            }
            else
            {
                <div class="hbars compact">
                    @foreach (var s in Model.TopMissing)
                    {
                        double w = s.Count * 100.0 / maxMissing;
                        <div class="hbar-row stack">
                            <span class="hbar-label full" title="@s.Name">@s.Name</span>
                            <div class="row-inline">
                                <div class="bar"><div class="bar-fill low" style="width:@(w.ToString("0", inv))%"></div></div>
                                <b class="hbar-value">@s.Count</b>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    </div>

    <section class="panel">
        <h4>Кандидати та результати аналізу</h4>

        @if (Model.Table.Count == 0)
        {
            <p class="muted">Кандидатів поки немає.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="atable">
                    <thead>
                        <tr>
                            <th>Кандидат</th>
                            <th>Статус</th>
                            <th>Відповідність</th>
                            <th>Досвід</th>
                            <th>Вердикт</th>
                            <th>Навички</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Table)
                        {
                            string statusKey = c.Status == AnalysisStatus.Done ? "done" : c.Status == AnalysisStatus.Failed ? "failed" : "pending";
                            double pct = Math.Clamp(c.MatchPercent ?? 0, 0, 100);
                            string level = pct >= 75 ? "high" : pct >= 50 ? "mid" : "low";
                            <tr>
                                <td><b>@c.Name</b><div class="muted small">@c.Date.ToString("dd.MM.yyyy HH:mm")</div></td>
                                <td><span class="badge @statusKey">@c.Status</span></td>
                                <td class="match-cell">
                                    @if (c.Status == AnalysisStatus.Done && c.MatchPercent.HasValue)
                                    {
                                        <div class="mini"><div class="bar"><div class="bar-fill @level" style="width:@(pct.ToString("0", inv))%"></div></div><b>@pct.ToString("0")%</b></div>
                                    }
                                    else { <span class="muted">—</span> }
                                </td>
                                <td>@(c.ExperienceYears.HasValue ? c.ExperienceYears.Value.ToString("0.#") + " р." : "—")</td>
                                <td>@(string.IsNullOrEmpty(c.Verdict) ? "—" : c.Verdict)</td>
                                <td>
                                    @if (c.Skills.Count == 0) { <span class="muted">—</span> }
                                    else
                                    {
                                        <div class="tags">
                                            @foreach (var s in c.Skills.Take(4)) { <span class="tag">@s</span> }
                                            @if (c.Skills.Count > 4) { <span class="tag more">+@(c.Skills.Count - 4)</span> }
                                        </div>
                                    }
                                </td>
                                <td><a class="btn-ghost sm" asp-controller="Dashboard" asp-action="Details" asp-route-key="@c.Id">Детальніше</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
