@{
    ViewData["Title"] = "Деталі завдання";
}

<h2>Завдання: @ViewBag.TaskKey</h2>

<pre style="white-space: pre-wrap; background: #f5f5f5; padding: 15px; border: 1px solid #ccc;">@ViewBag.TzText</pre>

<hr />

<h4>Взятися за це завдання — надіслати резюме:</h4>

@if (ViewBag.Message != null)
{
    <div style="color: green; font-weight: bold; margin-bottom: 15px;">@ViewBag.Message</div>
}

<form asp-action="UploadResume" method="post" enctype="multipart/form-data"
      onsubmit="var b=document.getElementById('sendBtn'); b.disabled=true; b.innerText='Надсилаємо...';">
    <input type="hidden" name="taskKey" value="@ViewBag.TaskKey" />

    <label>Ваше ім'я:</label><br />
    <input type="text" name="candidateName" placeholder="Ім'я Прізвище" /><br /><br />

    <label>Файл резюме (PDF або TXT):</label><br />
    <input type="file" name="resumeFile" accept=".pdf,.txt" /><br /><br />

    <button type="submit" id="sendBtn">Надіслати резюме на це завдання</button>
</form>

<hr />
<a asp-action="Candidates">← Назад до списку завдань</a>